API_ID=123456
API_HASH=your_api_hash
BOT_TOKEN=123456:your_bot_token

# Optional global GoFile API token. Leave blank for guest uploads.
GOFILE_API_TOKEN=

# Comma-separated Telegram user IDs with sudo/admin privileges.
SUDO_USERS=123456789

DOWNLOAD_DIR=/data/downloads
WORK_DIR=/data/work
DB_PATH=/data/bot.sqlite3

# Hard global processing limit. Per-user limit is always 1.
MAX_CONCURRENT_JOBS=10
PROGRESS_INTERVAL=3

# Idle timeout for files/workflows (6 hours).
SESSION_TIMEOUT=21600

# Direct/stream links. Railway/Render are auto-detected when possible.
PUBLIC_BASE_URL=
WEB_HOST=0.0.0.0
WEB_PORT=8080
DIRECT_LINK_TTL=86400

TELEGRAPH_ACCESS_TOKEN=
