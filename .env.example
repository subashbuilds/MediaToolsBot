# Telegram MTProto bot credentials
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=123456:REPLACE_ME

# Optional default GoFile API token. Users can also set /setgofile <token>.
GOFILE_API_TOKEN=

# Storage
DOWNLOAD_DIR=/data/downloads
WORK_DIR=/data/work
DB_PATH=/data/bot.sqlite3
MAX_CONCURRENT_JOBS=2

# Progress updates
PROGRESS_INTERVAL=3

# Optional: restrict bot to these Telegram numeric user IDs, comma separated.
# Leave empty to allow everyone.
SUDO_USERS=
