BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Comma separated Telegram user IDs. Empty = bot open to everyone.
SUDO_USERS=

# Work directory inside container.
WORK_DIR=/data/work
MAX_CONCURRENT_JOBS=2
KEEP_FILES=false

# Optional default GoFile API token. Per-user /setgofile overrides this.
GOFILE_API_TOKEN=
GOFILE_UPLOAD_REGION=auto

# Optional public base URL used by /link. If empty, /link returns local file path only.
PUBLIC_BASE_URL=

# Telegram Local Bot API server. Recommended for large Telegram files.
# Example when using the bundled compose setup:
# TELEGRAM_API_BASE=http://telegram-bot-api:8081
TELEGRAM_API_BASE=

# Set to false only if you deliberately want standard Telegram Bot API limits.
USE_LOCAL_BOT_API=false
